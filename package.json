{
  "name": "private-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "demos/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf .nx node_modules packages/*/node_modules packages/*/dist packages/*/build",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "tsc": "tsc -b",
    "test": "vitest run --coverage",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "build": "pnpm --filter yargs-file-commands build",
    "build:release": "pnpm build && node scripts/prepare-package.mjs",
    "size": "size-limit",
    "release": "semantic-release",
    "test:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^14.0.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.0.0",
    "typescript": "^7",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "size-limit": [
    {
      "name": "Published JavaScript (gzip)",
      "path": "packages/yargs-file-commands/publish/dist/**/*.js",
      "limit": "10 kB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
