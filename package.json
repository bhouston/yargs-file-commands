{
  "name": "yargs-file-commands-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:build": "pnpm --filter @yargs-file-commands/website build",
    "docs:dev": "pnpm --filter @yargs-file-commands/website dev",
    "prepare": "husky",
    "clean": "rm -rf .nx node_modules packages/*/node_modules packages/*/dist packages/*/build",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "tsc": "pnpm -r tsc",
    "test": "vitest run --coverage",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --type-aware --type-check --fix .",
    "build": "pnpm --filter yargs-file-commands build",
    "build:release": "pnpm build",
    "size": "size-limit",
    "bench": "pnpm build && node packages/yargs-file-commands/bench/fileCommands.bench.mjs",
    "release": "semantic-release",
    "test:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.36",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^26.6.6",
    "@visulima/yaml": "1.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.3.0",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "size-limit": [
    {
      "name": "Published JavaScript (gzip)",
      "path": [
        "packages/yargs-file-commands/dist/**/*.js",
        "!packages/yargs-file-commands/dist/**/*.test.js",
        "!packages/yargs-file-commands/dist/**/fixtures/**"
      ],
      "limit": "10 kB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.16.1"
}
