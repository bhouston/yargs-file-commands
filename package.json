{
  "name": "private-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "demos/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf .nx node_modules packages/*/node_modules packages/*/dist packages/*/build",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "tsc": "tsc -b",
    "test": "pnpm vitest",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "make-release": "node ./scripts/make-release.ts packages/yargs-file-commands"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.0.8"
}
