{
  "name": "yargs-file-commands",
  "version": "1.2.2",
  "description": "A yargs helper function that lets you define your commands structure via directory and file naming conventions.",
  "keywords": [
    "automatic",
    "commandDir",
    "directory",
    "file-router",
    "files",
    "helper",
    "nodejs",
    "typescript",
    "yargs"
  ],
  "homepage": "https://github.com/bhouston/yargs-file-commands#readme",
  "bugs": {
    "url": "https://github.com/bhouston/yargs-file-commands/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/yargs-file-commands"
  },
  "source": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "!**/*.test.*",
    "!**/fixtures/**",
    "!**/*.tsbuildinfo",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
